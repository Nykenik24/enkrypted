<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>WS Test</title>

    <style>
        body {
            margin: 0;
            font-family: monospace;
            background: #0f1117;
            color: #ddd;
        }

        #log {
            height: calc(100vh - 60px);
            overflow: auto;
            padding: 10px;
        }

        #bar {
            height: 60px;
            display: flex;
            gap: 8px;
            padding: 10px;
            box-sizing: border-box;
            background: #151823;
        }

        input, button {
            background: #1e2230;
            border: 1px solid #333;
            color: white;
            padding: 6px;
        }

        #msg {
            flex: 1;
        }

        .msg {
            margin: 4px 0;
        }
    </style>
</head>

<body>

<div id="log"></div>

<div id="bar">
    <input id="url" value="ws://localhost:8080/ws" />
    <input id="username" placeholder="username" />
    <button id="connect">connect</button>

    <input id="msg" placeholder="message" />
    <button id="send">send</button>
</div>

<script>
let ws;
let connected = false;
let username = "";

const log = (m) => {
    const el = document.createElement("div");
    el.className = "msg";
    el.textContent = typeof m === "string" ? m : JSON.stringify(m);
    document.getElementById("log").appendChild(el);
};

document.getElementById("connect").onclick = () => {
    const url = document.getElementById("url").value;
    username = document.getElementById("username").value || "anon";

    ws = new WebSocket(url);

    ws.onopen = () => {
        connected = true;
        log("connected");

        // identify event (important for your backend)
        ws.send(JSON.stringify({
            kind: "enkr:identify",
            payload: {
                username: username
            }
        }));
    };

    ws.onclose = () => {
        connected = false;
        log("disconnected");
    };

    ws.onmessage = (e) => {
        try {
            log(JSON.parse(e.data));
        } catch {
            log(e.data);
        }
    };
};

document.getElementById("send").onclick = () => {
    if (!connected) return;

    const msg = document.getElementById("msg").value;

    ws.send(JSON.stringify({
        kind: "enkr:msg",
        payload: {
            contents: msg,
            timestamp: new Date().toISOString()
        }
    }));

    document.getElementById("msg").value = "";
};
</script>

</body>
</html>
